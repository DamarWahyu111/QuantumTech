      "regex": "^/careers/life\\-at\\-quantumtech(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/careers/life\\-at\\-quantumtech(?:/)?$"
    },
    {
      "page": "/careers/open-positions",
      "regex": "^/careers/open\\-positions(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/careers/open\\-positions(?:/)?$"
    },
    {
      "page": "/case-studies",
      "regex": "^/case\\-studies(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/case\\-studies(?:/)?$"
    },
    {
      "page": "/company-culture",
      "regex": "^/company\\-culture(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/company\\-culture(?:/)?$"
    },
    {
      "page": "/our-team",
      "regex": "^/our\\-team(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/our\\-team(?:/)?$"
    },
    {
      "page": "/submit-testimonial",
      "regex": "^/submit\\-testimonial(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/submit\\-testimonial(?:/)?$"
    },
    {
      "page": "/tech-trends",
      "regex": "^/tech\\-trends(?:/)?$",
      "routeKeys": {},
